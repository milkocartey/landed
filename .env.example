# Copy this file to ".env" and fill what you need. Everything is optional.

# Live internship offers from Adzuna (free key: https://developer.adzuna.com/signup)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Writing engine: auto | transformers | ollama | template
#   auto = Ollama if it is running, else transformers, else template
LANDED_LLM=auto
LANDED_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# If you use Ollama (https://ollama.com): ollama pull qwen2.5:1.5b
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434

# Matching engine: auto (sentence-transformers) | tfidf
LANDED_EMBEDDINGS=auto
LANDED_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

PORT=8000
